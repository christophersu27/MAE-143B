clear; clc; close all;
d=12; a0=.02; 
G = RR_pade(d,2,2) * RR_tf(1,[1/a0 1]); 
g.T = 200;
D=1; 
P=1/0.5;
figure(1), RR_rlocus(G), axis([-.4 .3 -.3 .3])
title('Delayed Bath Plant')
figure(2), g.T=200; RR_step(35+10*P*G*D/(1+G*D),g); axis([0 200 32 55])
title('Bath Temp. [D(s) = 1]')
figure(3); RR_step(35+10*P*D/(1+G*D),g); axis([0 200 40 60])
title('Valve Temp. [D(s) = 1]')
% Proportional
Kp = 0.4;
D = Kp;
P = (1+Kp)/Kp;

figure(4); RR_step(35+10*P*G*D/(1+G*D), g); axis([0 200 32 55])
title('Proportional: Bath Temperature')
figure(5); RR_step(35+10*P*D/(1+G*D), g); axis([0 200 40 52])
title('Proportional: Valve Temperature')

% Lag Controller
K = 0.90; z = 0.032; p = 0.008;
D_lag = K * RR_tf([1 z],[1 p]);

D0 = K*z/p;
P_lag = (1+D0)/D0;

figure(6); RR_step(35+10*P_lag*G*D_lag/(1+G*D_lag), g); axis([0 200 32 55])
title('Lag (F_{2,2}): Bath Temperature')
figure(7); RR_step(35+10*P_lag*D_lag/(1+G*D_lag), g); axis([0 200 40 52])
title('Lag (F_{2,2}): Valve Temperature')

F_16_13 = RR_pade(d,16,13);
G_16 = F_16_13 * RR_tf(1,[1/a0 1]);
figure(8); RR_step(35+10*P_lag*G_16*D_lag/(1+G_16*D_lag), g); axis([0 200 32 55])
title('Lag (F_{16,13}): Bath Temperature')
figure(9); RR_step(35+10*P_lag*D_lag/(1+G_16*D_lag), g); axis([0 200 40 52])
title('Lag (F_{16,13}): Valve Temperature')
